+/* ---------- ANNOUNCEMENT BAR: Sept pause notice, dismissible, pushes nav/header down by its real height ---------- */
+(function(){
+  const bar=document.getElementById("announce-bar");
+  const closeBtn=document.getElementById("announce-x");
+  if(!bar||!closeBtn) return;
+  const KEY="lace_ann_dismissed_2026_09_pause"; // dated key so a future banner isn't hidden by this one's dismissal
+  function setOffset(px){ document.documentElement.style.setProperty("--ann-h", px+"px"); }
+  function measure(){ if(bar.style.display!=="none") setOffset(bar.offsetHeight); }
+  let dismissed=false;
+  try{dismissed=!!localStorage.getItem(KEY);}catch(e){}
+  if(dismissed){
+    bar.style.display="none";
+    setOffset(0);
+  } else {
+    measure();
+    window.addEventListener("resize", measure);
+  }
+  closeBtn.addEventListener("click",()=>{
+    bar.style.display="none";
+    setOffset(0);
+    try{localStorage.setItem(KEY,"1");}catch(e){}
+  });
+})();
